# Copy to .env (never commit .env).
# SECRET_KEY signs logins and encrypts users' API keys. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
POSTGRES_PASSWORD=
INGEST_EVERY_MINUTES=30
# Set to 1 when the site is served over https
SECURE_COOKIES=0
# Address people use to open the site (used in password-reset links)
PUBLIC_URL=http://127.0.0.1:8000
# Optional, for password-reset emails. Free: a Gmail address + an app password (about 500 emails/day).
# Without these, the reset link is written to the web log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Optional: "Connect Gmail" so replies to applications update job statuses (read-only).
# Free in Google Cloud: create an OAuth client (Web application), redirect URI = PUBLIC_URL/google/callback,
# keep the app in "Testing" and add up to 100 test users. More users need Google's verification
# and a yearly third-party security assessment (gmail.readonly is a restricted scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
