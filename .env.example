# Copy to .env and fill in. Never commit .env.

# Claude API key for AI tailoring (optional — without it, a rule-based fallback is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Database: leave empty to use a local SQLite file (data/jobs.db)
# Docker Compose sets this to the Postgres service automatically.
DATABASE_URL=

# Gmail: read job-alert emails (LinkedIn, StepStone, Indeed, XING) and send the daily digest.
# Use a Gmail *App Password* (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: Telegram digest (create a bot with @BotFather, get your chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Jako (personal assistant) ---
# Telegram: create a bot with @BotFather, paste its token above (TELEGRAM_BOT_TOKEN).
# Send your bot "hi" once; it replies with your chat id for TELEGRAM_CHAT_ID.
# Google Calendar (read-only): Calendar settings > your calendar > "Secret address in iCal format".
GOOGLE_CALENDAR_ICS_URL=
JAKO_MODEL=claude-sonnet-5-5
JAKO_OWNER_NAME=Nanda
JAKO_CITY=Berlin
JAKO_LATITUDE=52.52
JAKO_LONGITUDE=13.405
JAKO_BRIEFING_TIME=08:00
